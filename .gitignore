.figma/
.figma-make/

# ==========================================
# 6. IDES e Editores de Código
# ==========================================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ)
.idea/

# Outros
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
